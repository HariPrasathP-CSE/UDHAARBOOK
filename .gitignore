# ==========================================
# UdhaarBook — Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
*/node_modules/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Build & Distribution Outputs
dist/
dist-ssr/
build/
client/dist/
*.local

# Embedded Database & Persistent Local Storage
.mongo-data/
server/.mongo-data/
*.mongodb-binaries/

# Logs & Diagnostic Outputs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# Testing & Coverage
coverage/
.nyc_output/
*.lcov

# Vite & Bundler Cache
.vite/
client/.vite/
.cache/

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# IDE & Editor Configurations
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
